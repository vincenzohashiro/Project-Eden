# Supabase project (Project Settings → API in the Supabase dashboard)
# The anon key is safe to expose in the browser — it's designed for that.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Discord application (Discord Developer Portal)
# These are only ever used server-side (Supabase Edge Function secrets /
# scripts/register-discord-commands.mjs) — never exposed to the browser.
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
