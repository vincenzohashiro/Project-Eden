# Local port the Fastify app binds to (127.0.0.1 only — nginx fronts it in production).
PANEL_PORT=3000

# Supabase project (Project Settings -> API in the Supabase dashboard).
SUPABASE_URL=
# Project Settings -> API -> JWT Settings -> "JWT Secret" (legacy HS256 signing secret).
# Used to verify access tokens locally without a round trip to Supabase.
SUPABASE_JWT_SECRET=
# Project Settings -> API -> "service_role" key. Server-only — bypasses RLS,
# used to look up profiles.role. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Pterodactyl Panel — see ../pterodactyl-setup/README.md for how to get these.
PTERODACTYL_PANEL_URL=https://ptero.projecteden.net
# Client API key for a dedicated Pterodactyl user scoped to just this server.
# Server-only — never expose to the browser.
PTERODACTYL_API_KEY=
# The server's short identifier (from its Panel URL, /server/<identifier>).
PTERODACTYL_SERVER_ID=

# RCON connection, used only for the player list (Wings/Pterodactyl don't
# track Minecraft players — everything else goes through the Pterodactyl API).
# Port is whatever allocation Pterodactyl assigned for RCON on this server;
# never expose it to the internet, only reachable over 127.0.0.1.
MC_RCON_HOST=127.0.0.1
MC_RCON_PORT=25575
MC_RCON_PASSWORD=

# Comma-separated list of origins allowed to call this API (the production
# Vercel domain plus http://localhost:5173 for local frontend dev).
ALLOWED_ORIGINS=http://localhost:5173
